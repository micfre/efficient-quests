# Third-party local reference copies
/prior_art/

# Local tooling and credentials
/.agents/
/.claude/skills
/.codex/
/.aws/
.env
.env.*
!.env.example

# Generated artifacts. The addon source itself is tracked under
# dist/EfficientQuests, so ignore only the other content of dist/.
# Ephemeral test builds land under build/: the bridge suite builds its
# fixture plugin into build/bridge-test, and the CI release dry-run
# builds its fixture packages into build/ci-dry-run.
/dist/*
!/dist/EfficientQuests/
/build/
*.zip

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*~

# Python bytecode
__pycache__/
*.pyc
