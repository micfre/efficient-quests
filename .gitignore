# Third-party local reference copies
/prior_art/

# Local tooling and credentials
/.agents/
/.claude/skills
/.codex/
/.aws/
.env
.env.*
!.env.example

# Generated artifacts. The addon source itself is tracked under
# dist/EfficientQuests, so ignore only the other content of dist/.
# The bridge suite builds its fixture plugin into tests/bridge-test.
/dist/*
!/dist/EfficientQuests/
/build/
/tests/bridge-test/
*.zip

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*~

# Python bytecode
__pycache__/
*.pyc
